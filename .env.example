# Required
GROQ_API_KEY=your_key_here

# Model (change this if Groq retires a model, no code change needed)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=5000

# Retrieval
RETRIEVAL_STRATEGY=hybrid        # vector | hybrid | hybrid_rerank
TOP_K=5
CANDIDATE_K=20
MIN_RELEVANCE=0.25               # tune with: python -m evaluation.run_eval --tune-threshold
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Behavior
DEFAULT_MODE=strict              # strict | flexible
DEFAULT_DOMAIN=general

# Server
API_URL=http://localhost:8000    # used by the Streamlit UI
CORS_ORIGINS=http://localhost:8501
MAX_UPLOAD_MB=20
ALLOW_PRIVATE_URLS=false         # keep false on any public deployment
